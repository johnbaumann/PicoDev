.define GPIO_ADDR   11
.define GPIO_RD     12
.define GPIO_WR     13
.define GPIO_CS     14

.define IRQ_UPDATESTATUS    0

.define IRQ_READDATA_PIO    4
.define IRQ_READSTATUS_PIO  5
.define IRQ_WRITEDATA_PIO   6


; Auto-pulls data from FIFO and pushes it to the pins, which is pushed by DMA
; The value of the pins is grabbed from the other SM
; This is the closest thing to accessing memory directly
.program statuspins
    out pins, 8
.wrap

; Output data to pins from TX FIFO
.program readdata
    mov x, ~null                    ; pre-load x with all ones, so data returns 0xff if FIFO is empty

.wrap_target
    wait 1 irq IRQ_READDATA_PIO
    pull noblock
    out pins, 8
    irq nowait IRQ_UPDATESTATUS     ; Wait for cpu to update status bit
.wrap


; Monitor the RD signal, push status to pins or trigger data out
.program cpufifo
.side_set 3 opt pindirs

    mov x, null                     ; pre-load x with all zeros, so status returns 0x00 if FIFO is empty
.wrap_target
    set pindirs, 0b00000 side 0b000 ; Set 8 data pins to input

idle:
    mov isr, null                   ; Clear the ISR register
    wait 0 GPIO GPIO_CS             ; wait for CS to assert low
    jmp pin idle                    ; jmp to idle if rd not asserted
    in pins, 1                      ; read the address pin
    mov y, isr                      ; Copy ISR to y so we can branch on address pin
    jmp !y doData                   ; Address pin is low, send data, otherwise, status

doStatus:
    in pins 9
    in null, 24
    mov pins, isr                   ; Copy the ISR register to the pins
    jmp setPinsAsOutput             ; Set the pins as output and wait for RD to finish

doData:
    irq wait IRQ_READDATA_PIO       ; Wait for the data SM to push data onto the pins

setPinsAsOutput:
    set pindirs, 0b11111 side 0b111 ; set 8 data pins to output

;readstall:
    WAIT 1 GPIO GPIO_RD             ; Wait for RD to finish
.wrap


; Monitor the WR signal, push data to the RX FIFO
.program writedata

idle:
    wait 0 GPIO GPIO_CS             ; Wait for CS to assert low
    jmp pin idle                    ; jmp to start if wr not asserted
    in pins, 8                      ; read 8 bits from data pins
    push noblock                    ; push the data onto the RX FIFO

;writestall:
    irq nowait IRQ_UPDATESTATUS     ; Wait for cpu to update status bit
    wait 1 GPIO GPIO_WR             ; Wait for WR to finish
.wrap