.define GPIO_CS     1
.define GPIO_RD     26
.define GPIO_WR     27


; Output data to pins from TX FIFO
; USB -> PSX
.program readdata
.side_set 3 opt pindirs
    mov isr, null                   ; Clear the ISR register

idle:
    wait 0 GPIO GPIO_CS             ; wait for CS to assert low
    jmp pin idle                    ; jmp to idle if rd not asserted
    in pins, 1                      ; read the address pin
    mov y, isr                      ; Copy ISR to y so we can branch on address pin
    jmp !y sendData                 ; Send status if address pin is low, otherwise send data

;sendStatus:
    in pins 11                      ; Read up to status pins
    in null, 24                     ; Shift out everything but the status pins
    mov pins, isr                   ; Finally, copy the value to the output pins
    jmp outputWait

sendData:
    pull noblock                    ; Pull data from the TX FIFO, but don't block if empty
    out pins, 8                     ; Output the data to the pins

outputWait:
    set pindirs, 0b11111 side 0b111 ; set 8 data pins to output
    wait 1 GPIO GPIO_RD             ; Wait for RD to end
    set pindirs, 0b00000 side 0b000 ; Set 8 data pins to input
.wrap


; Status program
; Constantly pushes DMA status byte to the status pins
; The status pins are used by the read program as a hacky status register
.program statusreg
    out pins, 8
.wrap


; Monitor the WR signal, push data to the RX FIFO
; PSX -> USB
.program writedata

idle:
    wait 0 GPIO GPIO_CS             ; Wait for CS to assert low
    jmp pin idle                    ; jmp to start if wr not asserted

;writestall:
    wait 1 GPIO GPIO_WR             ; Wait for WR to finish
    in pins, 8                      ; read 8 bits from data pins
.wrap
